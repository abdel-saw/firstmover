# Copy to .env for local use. Never commit .env. Choose a local organizer password to access the studio.
DATABASE_URL=sqlite:///./caseweave.db
COOKIE_SECURE=false
MAX_SESSIONS=1000
# Generate a strong random token locally; required for sandbox import/submission.
ADMIN_TOKEN=
ORGANIZER_PASSWORD=
# SANDBOX credentials only. Live PayPal endpoints are intentionally unsupported.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# OpenAI-compatible chat completion endpoint. Use AI_JSON_MODE=prompt for portable JSON.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# prompt = JSON requested in instructions; json_object = provider response_format parameter.
AI_JSON_MODE=json_object
AI_MAX_TOKENS=1800
# Within an Astropods agent, leave AI_BASE_URL/AI_API_KEY/AI_MODEL unset to use
# injected ASTRO_GATEWAY_URL / ASTRO_GATEWAY_API_KEY / MODEL_DEFAULT automatically.
# Do not copy managed gateway credentials out of Astropods.

# Render side of the outbound Astropods worker transport:
# Set both the transport and a strong shared token in Render's secret settings.
AI_TRANSPORT=direct
DRAFTER_SHARED_TOKEN=
DRAFTER_WAIT_SECONDS=55
# Worker-only settings belong in Astropods, not Render:
# FIRSTMOVER_URL=https://firstmover.onrender.com
# DRAFTER_MAX_CALLS=100
# DRAFTER_REQUESTS_PER_MINUTE=6
# DRAFTER_POLL_SECONDS=5
