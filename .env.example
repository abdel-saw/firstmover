# Copy to .env for local use. Never commit .env. No credentials are required for sample workflows.
DATABASE_URL=sqlite:///./caseweave.db
COOKIE_SECURE=false
MAX_SESSIONS=1000
# Generate a strong random token locally; required for sandbox import/submission.
ADMIN_TOKEN=
# SANDBOX credentials only. Live PayPal endpoints are intentionally unsupported.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# OpenAI-compatible chat completion endpoint. Provider must support JSON object responses.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
