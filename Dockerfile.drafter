FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend
WORKDIR /app
COPY backend/requirements-drafter.txt /app/backend/requirements-drafter.txt
RUN pip install --no-cache-dir -r backend/requirements-drafter.txt
COPY backend/caseweave/__init__.py backend/caseweave/config.py backend/caseweave/analysis.py backend/caseweave/drafting.py backend/caseweave/drafter.py backend/caseweave/campaign_planner.py /app/backend/caseweave/
# Astropods custom HTTP agents are required to listen on port 80.
EXPOSE 80
CMD ["uvicorn", "caseweave.drafter:app", "--host", "0.0.0.0", "--port", "80", "--no-access-log"]
