FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend
WORKDIR /app
COPY backend/requirements-drafter.txt /app/backend/requirements-drafter.txt
RUN pip install --no-cache-dir -r backend/requirements-drafter.txt
COPY backend/firstmover/__init__.py backend/firstmover/config.py backend/firstmover/drafting.py backend/firstmover/drafter.py backend/firstmover/campaign_planner.py /app/backend/firstmover/
# Astropods custom HTTP agents are required to listen on port 80.
EXPOSE 80
CMD ["uvicorn", "firstmover.drafter:app", "--host", "0.0.0.0", "--port", "80", "--no-access-log"]
